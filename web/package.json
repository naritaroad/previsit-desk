    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
