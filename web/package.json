{
  "name": "previsit-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "PreVisit Desk web client: public site, patient app, clinic, pharmacy and admin workspaces",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "npm run i18n:check && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-tc": "^5.3.1",
    "@fontsource-variable/noto-serif-tc": "^5.3.1",
    "@hookform/resolvers": "^7.0.9",
    "@tabler/icons-react": "^3.53.0",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-query-persist-client": "^5.108.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^27.2.7",
    "i18next-browser-languagedetector": "^8.3.1",
    "idb-keyval": "^6.3.0",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.3",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.3",
    "recharts": "^3.11.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
