{
  "name": "previsit-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PreVisit Desk web client: patient pre-visit page, safety page and clinician review",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite",
    "build": "npm run i18n:check && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test": "node --test tests/*.test.ts",
    "mock": "node scripts/mock-api.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "i18next": "^26.5.10",
    "i18next-browser-languagedetector": "^8.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.8",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
