# PreVisit Desk local settings. Never commit this file (.gitignore).
# --- Database (docker compose up -d db) ---
POSTGRES_DB=previsit
POSTGRES_USER=previsit
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433
DATABASE_URL=postgres://previsit:CHANGE_ME@127.0.0.1:5433/previsit

# --- API ---
BIND_ADDR=127.0.0.1:8088
WEB_DIR=web/dist
DATA_DIR=data
# Behind the Cloudflare Tunnel the real client address is in this header (empty = use the socket address).
CLIENT_IP_HEADER=

# --- Model (names are env-only; verified 2026-11-25, see .agent-context/DECISIONS.md) ---
# LLM_MODEL=mock selects the offline keyword gateway for tests (no key needed).
LLM_MODEL=gemini-3.5-flash
LLM_MODEL_FALLBACK=gemini-3.1-flash-lite
# Thinking level sent to Gemini 3 models: minimal|low|medium|high|default (3.8-flash rejects minimal; use low). Fallback model gets none.
LLM_THINKING=minimal
GEMINI_API_KEY=
AGENT_MAX_STEPS=5
LLM_TIMEOUT_SECS=45
# Pause between eval turns (ms); raise on the free tier to avoid 429.
EVAL_DELAY_MS=4000

# --- Public-demo abuse limits ---
DAILY_MODEL_CALL_LIMIT=800
RATE_MESSAGES_PER_10MIN=20
RATE_VISITS_PER_10MIN=10
MAX_MESSAGE_CHARS=800
# Model calls one client may cost per Taipei day (every attempt counts, in memory, reset on restart).
PER_IP_DAILY_CALL_LIMIT=200
# Patient messages one visit may hold before the model stops answering it (red flags, scope rules and the refill form keep working).
MAX_MESSAGES_PER_VISIT=40

# --- Clinician demo account (the only login) ---
CLINICIAN_USERNAME=dr_demo
CLINICIAN_PASSWORD=CHANGE_ME
CLINICIAN_DISPLAY_NAME=Demo Clinician
COOKIE_SECURE=false
SESSION_DAYS=7

# --- Privacy ---
RETENTION_DAYS=14
